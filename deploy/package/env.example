# SCM 的配置。安装脚本照这个模板生成 .env：密码和密钥随机生成，其他照抄这里的默认值。
#
# .env 里有密码：权限是 600，只有 root 能看。不要发给别人、不要截图；远程协助时不要在共享的屏幕上打开它。
# 改了 .env 以后，在安装目录里执行 sudo docker compose up -d 生效（只重建用到改动项的服务）。
# 升级不会改动已有的项，只会把新版本多出来的项加在末尾。

# 版本号。安装、升级脚本自动填写，平时不要改（回滚时例外，见部署手册第 7 节）
SCM_VERSION=

# 对外的端口：HTTP 默认 80；HTTPS 模式再加一个 HTTPS 端口，默认 443。
# 只想让本机上的其他程序（比如已有的反向代理）访问时，可以写成 127.0.0.1:8080 这样
SCM_HTTP_PORT=80
SCM_HTTPS_PORT=443

# http：只开 HTTP。前面已经有负载均衡、网关负责 HTTPS，或者只在内网用、试用期，用这个。
# https：证书直接放在这台机器上（certs/fullchain.pem、certs/privkey.pem），HTTP 自动跳到 HTTPS。
# 怎么选见部署手册第 4 节
SCM_WEB_MODE=http

# 只有前置网关终止 HTTPS、到本机使用 HTTP 时才设 https；空值按本机实际协议。
# Nginx 会覆盖客户端传入的协议头，不能用伪造 X-Forwarded-Proto 影响 Cookie。
SCM_PUBLIC_SCHEME=

# 专用入口网段。应用只信任这一台 Nginx 的 /32 地址；与现有 Docker 网段冲突时同时改两项。
SCM_EDGE_SUBNET=172.30.250.0/28
SCM_EDGE_WEB_IP=172.30.250.2

# 数据库密码。只在第一次启动建库时生效，装好以后不要改：改了数据库不认，应用就连不上了
POSTGRES_PASSWORD=

# Redis 密码。Redis 里只有登录状态和缓存
REDIS_PASSWORD=

# 登录令牌的签名密钥（Base64）。改了以后所有人要重新登录一次
JWT_SECRET=

# 上传文件（图片、附件）地址的签名密钥，Nginx 和应用共用。地址上带着过期时间和签名，转发出去的链接一周左右就打不开了。
# 只能用字母、数字、- 和 _，至少 32 位。改了以后，已经打开的页面上的图片显示不出来，刷新页面就好；上传的文件本身不受影响
FILE_SIGN_KEY=

# 管理员 admin 的初始密码：只在第一次启动、库里还没有 admin 时用。登录以后马上在右上角改掉，改掉以后这一项就不起作用了
INIT_ADMIN_PASSWORD=

# 每天几点备份数据库（24 小时制），选没人用系统的时候
BACKUP_TIME=02:30

# 每天的备份留几天
BACKUP_KEEP_DAYS=7

# ---- 智能助手（可选，部署手册第 10 节）----
# 要起助手就写 COMPOSE_PROFILES=assistant，再填下面的模型服务，然后 sudo docker compose up -d。
# 起了以后还要管理员在管理后台 › 系统管理 › AI 功能里打开开关，用户才看得到助手；关了开关谁也问不了
COMPOSE_PROFILES=

# 助手自己的库账号的密码（安装脚本随机生成，平时不用管）。账号只能动助手自己的表，读不到业务数据
ASSISTANT_DB_PASSWORD=

# 模型服务：OpenAI 兼容的接口地址（到 /v1 为止）、Key、模型名。没填时助手照样起，问话回"还没有配置模型"
ASSISTANT_LLM_BASE_URL=
ASSISTANT_LLM_API_KEY=
ASSISTANT_LLM_MODEL=

# external：外部云端模型，问话和查到的数据会发给模型服务商；self-hosted：公司内网自己部署的模型。
# 只用来在打开 AI 开关前提醒管理员数据去哪，不影响调用
ASSISTANT_LLM_MODE=external

# 模型服务不认 stream_options 参数（回 400）时改成 false
ASSISTANT_LLM_STREAM_USAGE=true

# 每人每天最多问几句；全系统每天最多用多少 token（一句话大约 2 万）
ASSISTANT_USER_DAILY_REQUESTS=200
ASSISTANT_DAILY_TOKENS=5000000

# 对话留几天：超过这么多天没再问的自动删掉（1–365）
ASSISTANT_RETENTION_DAYS=7

# ---- 钉钉推送（可选，部署手册第 12 节）----
# 用户打开系统的地址，比如 https://scm.example.com（不带结尾的 /）。钉钉消息里的"打开"按钮用它拼链接；空着消息照发，只是没有按钮
SCM_PUBLIC_URL=

# 钉钉开放平台上建的企业内部应用的 AppKey、AppSecret、AgentId。三个都填了才发消息；空着什么都不发
SCM_DINGTALK_APP_KEY=
SCM_DINGTALK_APP_SECRET=
SCM_DINGTALK_AGENT_ID=
