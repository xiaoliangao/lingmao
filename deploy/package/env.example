# SCM 的配置。安装脚本照这个模板生成 .env：密码和密钥随机生成，其他照抄这里的默认值。
#
# .env 里有密码：权限是 600，只有 root 能看。不要发给别人、不要截图；远程协助时不要在共享的屏幕上打开它。
# 改了 .env 以后，在安装目录里执行 sudo docker compose up -d 生效（只重建用到改动项的服务）。
# 升级不会改动已有的项，只会把新版本多出来的项加在末尾。

# 版本号。安装、升级脚本自动填写，平时不要改（回滚时例外，见部署手册第 7 节）
SCM_VERSION=

# 对外的端口：HTTP 默认 80；HTTPS 模式再加一个 HTTPS 端口，默认 443。
# 只想让本机上的其他程序（比如已有的反向代理）访问时，可以写成 127.0.0.1:8080 这样
SCM_HTTP_PORT=80
SCM_HTTPS_PORT=443

# http：只开 HTTP。前面已经有负载均衡、网关负责 HTTPS，或者只在内网用、试用期，用这个。
# https：证书直接放在这台机器上（certs/fullchain.pem、certs/privkey.pem），HTTP 自动跳到 HTTPS。
# 怎么选见部署手册第 4 节
SCM_WEB_MODE=http

# 数据库密码。只在第一次启动建库时生效，装好以后不要改：改了数据库不认，应用就连不上了
POSTGRES_PASSWORD=

# Redis 密码。Redis 里只有登录状态和缓存
REDIS_PASSWORD=

# 登录令牌的签名密钥（Base64）。改了以后所有人要重新登录一次
JWT_SECRET=

# 管理员 admin 的初始密码：只在第一次启动、库里还没有 admin 时用。登录以后马上在右上角改掉，改掉以后这一项就不起作用了
INIT_ADMIN_PASSWORD=

# 每天几点备份数据库（24 小时制），选没人用系统的时候
BACKUP_TIME=02:30

# 每天的备份留几天
BACKUP_KEEP_DAYS=7
