<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  款式列表、导出、选款式（RFC 005 §7）。
  品类名、尺码组名、尺码个数只读 JOIN bas_category、bas_size_group(_item)（架构 §3.2 规则 4）；设计师的名字调 UserService.nicknames，不 JOIN sys_user。
-->
<mapper namespace="com.lingmao.scm.module.style.mapper.StyleMapper">

    <sql id="listColumns">
        s.id, s.code, s.name, s.alias_name, s.style_class, s.brand, s.category_id, c.name AS category_name,
        s.year, s.season, s.wave, s.designer_id, s.size_group_id, g.name AS size_group_name,
        (SELECT count(*) FROM bas_size_group_item i WHERE i.size_group_id = s.size_group_id) AS size_count,
        (SELECT count(*) FROM sty_style_color sc WHERE sc.style_id = s.id) AS color_count,
        (SELECT count(*) FROM sty_style_sku k WHERE k.style_id = s.id) AS sku_count,
        s.tag_price, s.status, s.tech_pack_status, s.update_time
    </sql>

    <sql id="listFrom">
        FROM sty_style s
        <include refid="listJoins"/>
    </sql>

    <sql id="listJoins">
        JOIN bas_category c ON c.id = s.category_id
        JOIN bas_size_group g ON g.id = s.size_group_id
    </sql>

    <!-- 关键字：款号按包含查；名称、花名、品名包含完整短语；有分隔符时再加上按几个款号精确查（Keywords）。品类含下级（Service 算好 id） -->
    <sql id="listWhere">
        <where>
            <if test="q.keyword != null and q.keyword.trim() != ''">
                <bind name="keywordCode" value="@com.lingmao.scm.common.page.Keywords@codeContains(q.keyword)"/>
                <bind name="keywordContains" value="@com.lingmao.scm.common.page.Keywords@contains(q.keyword, 100)"/>
                AND (upper(s.code) LIKE #{keywordCode} OR s.name ILIKE #{keywordContains}
                     OR s.alias_name ILIKE #{keywordContains} OR s.product_name ILIKE #{keywordContains}
                     <if test="codes != null">OR upper(s.code) IN <foreach collection="codes" item="code" open="(" separator="," close=")">#{code}</foreach></if>)
            </if>
            <if test="categoryIds != null">
                AND s.category_id IN <foreach collection="categoryIds" item="id" open="(" separator="," close=")">#{id}</foreach>
            </if>
            <if test="q.styleClass != null and q.styleClass != ''">AND s.style_class = #{q.styleClass}</if>
            <if test="q.brand != null and q.brand != ''">AND s.brand = #{q.brand}</if>
            <if test="q.year != null">AND s.year = #{q.year}</if>
            <if test="q.season != null and q.season != ''">AND s.season = #{q.season}</if>
            <if test="q.wave != null and q.wave != ''">AND s.wave = #{q.wave}</if>
            <if test="q.designerId != null">AND s.designer_id = #{q.designerId}</if>
            <if test="q.status != null">AND s.status = #{q.status}</if>
            <if test="q.techPackStatus != null">AND s.tech_pack_status = #{q.techPackStatus}</if>
            <if test="q.ids != null and q.ids.size() > 0">
                AND s.id IN <foreach collection="q.ids" item="id" open="(" separator="," close=")">#{id}</foreach>
            </if>
        </where>
    </sql>

    <!-- 先执行款式自身的查询条件，再补分类/尺码组，避免小表统计变化导致沿外键扫描所有款式。 -->
    <sql id="matchingStyles">
        <if test="q.keyword != null and q.keyword.trim() != ''">
            WITH matching_styles AS MATERIALIZED (SELECT s.* FROM sty_style s <include refid="listWhere"/>)
        </if>
    </sql>

    <sql id="searchFrom">
        FROM <choose>
            <when test="q.keyword != null and q.keyword.trim() != ''">matching_styles</when>
            <otherwise>sty_style</otherwise>
        </choose> s
        <include refid="listJoins"/>
        <if test="q.keyword == null or q.keyword.trim() == ''"><include refid="listWhere"/></if>
    </sql>

    <!-- 新建的在前（原型的列表）：自动编号的款号里有日期，导入的老款号没有规律，所以按建档时间排 -->
    <select id="selectListPage" resultType="com.lingmao.scm.module.style.dto.StyleListVO">
        <include refid="matchingStyles"/>
        SELECT <include refid="listColumns"/>
        <include refid="searchFrom"/>
        ORDER BY s.create_time DESC, s.id DESC
    </select>

    <!-- 导出按款号排，方便在 Excel 里找 -->
    <select id="selectIds" resultType="java.lang.Long">
        <include refid="matchingStyles"/>
        SELECT s.id
        <include refid="searchFrom"/>
        ORDER BY s.code
        LIMIT #{limit}
    </select>

    <select id="selectPickPage" resultType="com.lingmao.scm.module.style.dto.StylePickVO">
        SELECT s.id, s.code, s.name, s.alias_name, s.brand, s.category_id, c.name AS category_name, s.year, s.season,
               s.tag_price, s.tech_pack_status, s.status
        FROM sty_style s
        JOIN bas_category c ON c.id = s.category_id
        WHERE s.status IN ('ENABLED'<if test="q.includeDraft != null and q.includeDraft">, 'DRAFT'</if>)
        <if test="q.keyword != null and q.keyword.trim() != ''">
            <bind name="keywordCode" value="@com.lingmao.scm.common.page.Keywords@codeContains(q.keyword)"/>
            <bind name="keywordContains" value="@com.lingmao.scm.common.page.Keywords@contains(q.keyword, 100)"/>
            AND (upper(s.code) LIKE #{keywordCode} OR s.name ILIKE #{keywordContains}
            OR s.alias_name ILIKE #{keywordContains}
            <if test="!brands.isEmpty()">OR s.brand IN <foreach collection="brands" item="b" open="(" separator="," close=")">#{b}</foreach></if>
            <if test="codes != null">OR upper(s.code) IN <foreach collection="codes" item="code" open="(" separator="," close=")">#{code}</foreach></if>)
        </if>
        <if test="categoryIds != null">
            AND s.category_id IN <foreach collection="categoryIds" item="id" open="(" separator="," close=")">#{id}</foreach>
        </if>
        ORDER BY s.code
    </select>

    <!-- 导入导出按编码对主力面料、默认加工厂：只读、只取编码和名称（架构 §3.2 规则 4） -->
    <select id="selectMaterialsByCodes" resultType="com.lingmao.scm.module.style.dto.LookupRow">
        SELECT id, code, name FROM bas_material
        WHERE code IN <foreach collection="codes" item="code" open="(" separator="," close=")">#{code}</foreach>
    </select>

    <select id="selectMaterialsByIds" resultType="com.lingmao.scm.module.style.dto.LookupRow">
        SELECT id, code, name FROM bas_material
        WHERE id IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>

    <select id="selectSuppliersByKeys" resultType="com.lingmao.scm.module.style.dto.LookupRow">
        SELECT id, code, short_name AS name FROM sup_supplier
        WHERE code IN <foreach collection="keys" item="key" open="(" separator="," close=")">#{key}</foreach>
           OR short_name IN <foreach collection="keys" item="key" open="(" separator="," close=")">#{key}</foreach>
    </select>

    <select id="selectSuppliersByIds" resultType="com.lingmao.scm.module.style.dto.LookupRow">
        SELECT id, code, short_name AS name FROM sup_supplier
        WHERE id IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
</mapper>
