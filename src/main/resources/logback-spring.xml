<configuration>
    <springProperty scope="context" name="APP_LOG" source="logging.file.name" defaultValue="./logs/scm.log"/>
    <springProperty scope="context" name="APP_ROLL" source="logging.logback.rollingpolicy.file-name-pattern" defaultValue="./logs/scm-%d{yyyy-MM-dd}.%i.log"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="com.lingmao.scm.common.log.SafeLogLayout"/>
        </encoder>
    </appender>
    <springProfile name="prod">
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${APP_LOG}</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${APP_ROLL}</fileNamePattern>
                <maxFileSize>100MB</maxFileSize><maxHistory>30</maxHistory><totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
            <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
                <layout class="com.lingmao.scm.common.log.SafeLogLayout"/>
            </encoder>
        </appender>
        <root level="INFO"><appender-ref ref="CONSOLE"/><appender-ref ref="FILE"/></root>
    </springProfile>
    <springProfile name="!prod"><root level="INFO"><appender-ref ref="CONSOLE"/></root></springProfile>
</configuration>
