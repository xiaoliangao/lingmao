# 复制成 application-local.yaml 再填后两项；application-local.yaml 在 .gitignore 里，不会进 git。
# 连接默认对应 dev/compose.yml 在本机起的 PostgreSQL 和 Redis（只绑 127.0.0.1，没有密码）。
DB_URL: jdbc:postgresql://127.0.0.1:5433/scm
DB_USER: scm
DB_PASSWORD: ""
REDIS_HOST: 127.0.0.1
REDIS_PORT: 6380
REDIS_PASSWORD: ""
# JWT 签名密钥：Base64，解码后至少 32 字节。生成：openssl rand -base64 48
JWT_SECRET: <生成的随机串>
# 库里还没有 admin 时，用它建 admin 的初始密码
INIT_ADMIN_PASSWORD: <初始密码>
