# 本机开发的配置：复制成 .env（gitignore，不进仓库）再填，pnpm dev 会读它。
# 命令行上给的同名环境变量优先于这里。全部配置项见 README 的"配置"一节。

# 助手自己的库账号（./dev/setup-db.sh 建的；本机开发库没有密码）
ASSISTANT_DATABASE_URL=postgres://scm_assistant@127.0.0.1:5433/scm
# app 的地址（IDEA 里起的是 8080，自己起的是 18080）
ASSISTANT_APP_URL=http://127.0.0.1:8080
# 从 app 的 /v3/api-docs 存下来的接口文档
ASSISTANT_OPENAPI=./openapi.json

# 模型服务（OpenAI 兼容接口）：地址写到 /v1 为止；地址和模型名要一起填，都空着就是不用模型
ASSISTANT_LLM_BASE_URL=
ASSISTANT_LLM_MODEL=
ASSISTANT_LLM_API_KEY=
# external：外部云端（数据出公司）；self-hosted：公司内网部署的
ASSISTANT_LLM_MODE=external
# 模型服务不认 stream_options 参数（回 400）时改成 false
ASSISTANT_LLM_STREAM_USAGE=true
